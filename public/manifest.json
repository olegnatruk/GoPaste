{
  "manifest_version": 3,
  "name": "GoPaste — Library & CodeChum",
  "description": "Save and share images and GIFs locally; use an optional CodeChum coding assistant with Gemini.",
  "version": "0.2.3",
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "downloads",
    "pageCapture",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/attachment-bridge.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open GoPaste",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "Open the GoPaste dashboard"
    },
    "start-script": {
      "suggested_key": "Alt+Shift+S",
      "description": "Start or resume CodeChum assistance on the active problem"
    },
    "stop-script": {
      "suggested_key": "Alt+Shift+X",
      "description": "Stop CodeChum assistance on the active problem"
    },
    "speed-up": {
      "description": "Increase CodeChum typing speed"
    },
    "speed-down": {
      "description": "Decrease CodeChum typing speed"
    }
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  }
}

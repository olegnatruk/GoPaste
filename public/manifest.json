{
  "manifest_version": 3,
  "name": "GoPaste",
  "description": "Save, organize, and share images and GIFs from a local library.",
  "version": "0.1.0",
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "downloads",
    "pageCapture",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open GoPaste",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "Open the GoPaste dashboard"
    }
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  }
}
